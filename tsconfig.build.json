{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.vue",
    "src/components/**/*.ts"
  ],
  "exclude": [
    "src/**/__tests__/**"
  ]
}
